# Optional: powers the `ask` command for natural-language analysis
ANTHROPIC_API_KEY=

# Your Sleeper league ID (from league URL: sleeper.com/leagues/LEAGUE_ID)
SLEEPER_LEAGUE_ID=

# Your Sleeper username or user_id (to identify your team)
SLEEPER_USERNAME=

# FantasyPros API key for ECR rankings & projections (https://www.fantasypros.com/api-data/)
FANTASYPROS_API_KEY=
