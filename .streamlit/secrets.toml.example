# Streamlit Cloud secrets — paste into: App settings → Secrets
# https://share.streamlit.io → your app → Settings → Secrets

# Required for auto-connect (recommended — config/league.json is not pushed to GitHub)
league_id = "YOUR_SLEEPER_LEAGUE_ID"
username = "YOUR_SLEEPER_USERNAME"
league_name = "My League"

# Optional
# fantasypros_api_key = "your_key"
